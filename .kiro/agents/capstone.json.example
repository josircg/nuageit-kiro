{
  "name": "capstone-fila-clara",
  "description": "Planeja, implementa e valida somente o capstone local da Fila Clara",
  "prompt": "Siga AGENTS.md. Mantenha escopo mínimo, peça aprovação antes de escrever e prove o resultado com testes e diff.",
  "tools": ["read", "write", "shell"],
  "allowedTools": ["read"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["./src/**", "./test/**", "./.kiro/specs/**", "./evidencias/**"]
    },
    "shell": {
      "allowedCommands": ["npm test", "git diff", "git diff --check", "git status --short"]
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/*/SKILL.md"
  ],
  "includeMcpJson": false
}
